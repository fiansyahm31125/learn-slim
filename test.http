@baseUrl = http://localhost:8000
# Isi dengan AUTH_TOKEN dari file .env (jangan commit token asli)
@token = 4c7b1c56a7cdcc983779143823309fbe56879f1ba093bfd866151b83082227e1
@productId = 1

############################################################
### S0 Health & Root
############################################################

### S01 GET / -> 200 OK (text/plain)
GET {{baseUrl}}/
Accept: */*

### S02 POST / -> 401
POST {{baseUrl}}/
Accept: application/json

############################################################
### P1 Product CRUD - happy path (route aktual public/index.php)
############################################################

### P01 GET semua produk -> 200 array JSON
GET {{baseUrl}}/products
Accept: application/json

### P02 GET satu produk ada -> 200 object
GET {{baseUrl}}/products/show/{{productId}}
Accept: application/json

### P03 GET satu produk tidak ada -> 404 {success:false, message, status}
GET {{baseUrl}}/products/show/9999
Accept: application/json

### P04 POST produk baru (JSON) -> 201
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "name": "Indomie Kuah",
  "price": 3501,
  "stock": 101
}

### P05 POST produk baru (form) -> 201 (BodyParsingMiddleware handle urlencoded)
POST {{baseUrl}}/products/create
Content-Type: application/x-www-form-urlencoded
Accept: application/json

name=Teh+Botol&price=5000&stock=50

### P06 POST produk tidak valid -> 422 {success:false, message:'Validasi gagal', errors}
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "price": -100,
  "stock": "abc"
}

### P07 GET halaman HTML produk (Twig) -> 200 text/html
GET {{baseUrl}}/products/page
Accept: text/html

### P08 GET halaman CRUD (Twig) -> 200 text/html
GET {{baseUrl}}/products/crud
Accept: text/html

### P09 PUT update produk ada (JSON) -> 200
PUT {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Kopi Arabika 200g",
  "price": 50000,
  "stock": 10
}

### P10 PUT update produk tidak ada -> 404
PUT {{baseUrl}}/products/9999
Content-Type: application/json
Accept: application/json

{
  "name": "Tidak Ada",
  "price": 1000,
  "stock": 10
}

### P11 DELETE produk tidak ada -> 404 (uji dulu pakai 9999, aman)
DELETE {{baseUrl}}/products/9999
Accept: application/json

### P12 DELETE produk ada -> 200 {message:'Produk berhasil dihapus'}
# Hati-hati: data hilang. Ganti id di bawah dengan id sisa/testing.
DELETE {{baseUrl}}/products/2
Accept: application/json

############################################################
### X1 Misc routes (index.php)
############################################################

### X01 Redirect helper /items -> 301 ke /products
GET {{baseUrl}}/items
Accept: application/json

### X02 Route group /users/{id}/billing -> 200 {id}
GET {{baseUrl}}/users/7/billing
Accept: application/json

### X03 Route group /users/{id}/product -> 200 array (ProductController::index)
GET {{baseUrl}}/users/7/product
Accept: application/json

### X04 GET /mcp -> 200 array (ProductController::index, bukan JSON-RPC)
GET {{baseUrl}}/mcp
Accept: application/json

### X05 GET /callbackbinding/{name} -> 200 + Set-Cookie: name=...
GET {{baseUrl}}/callbackbinding/budi
Accept: */*

### X06 GET /foo -> 401 {hello:world} (PSR-7 example)
GET {{baseUrl}}/foo
Accept: application/json

### X07 POST /foo echo query params -> 200 (coba ?a=1&b=2)
POST {{baseUrl}}/foo?a=1&b=2
Content-Type: application/json
Accept: application/json

{}

### PSR7-Example changing request
POST {{baseUrl}}/foo
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "price": -100,
  "stock": "abc"
}

############################################################
### ProductValidator.php - validateForCreate
### Route: POST /products/create -> 201 valid, 422 gagal
### Source: src/Validation/ProductValidator.php::validateForCreate
############################################################

### C01 CREATE valid -> 201
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "name": "Indomie Goreng",
  "price": 3500,
  "stock": 100
}

### C02 CREATE name missing -> 422 Name wajib diisi
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "price": 3500,
  "stock": 100
}

### C03 CREATE name empty string -> 422 Name wajib diisi
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "price": 3500,
  "stock": 100
}

### C04 CREATE name whitespace only -> 422 Name wajib diisi
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "name": "   ",
  "price": 3500,
  "stock": 100
}

### C05 CREATE name terlalu pendek (<3) -> 422 minimal 3 karakter
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "name": "AB",
  "price": 3500,
  "stock": 100
}

### C06 CREATE name terlalu panjang (>255) -> 422 maksimal 255 karakter
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "name": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
  "price": 3500,
  "stock": 100
}

### C07 CREATE price missing -> 422 Price wajib diisi
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "name": "Kopi Tubruk",
  "stock": 10
}

### C08 CREATE price string abc -> 422 harus berupa angka
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

