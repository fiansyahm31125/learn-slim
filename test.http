############################################################
### Exception Handling terstruktur (config/errorHandler.php
### + helper/apperror.php + src/Exception/HttpException.php)
### Envelope JSON: {success:false, message, status[, errors]}
### HTML (Accept:text/html): templates/error.html.twig (message+status saja)
### APP_DEBUG=false -> generik, tanpa trace/SQL/path/token
############################################################

### E01 404 produk tidak ada (JSON) -> {success:false, message:'Produk tidak ditemukan', status:404}
GET {{baseUrl}}/products/show/9999
Accept: application/json

### E02 404 produk tidak ada (HTML) -> error.html.twig, tanpa JSON bocor
GET {{baseUrl}}/products/show/9999
Accept: text/html

### E03 404 rute tidak ada (JSON) -> {success:false, message:'Rute tidak ditemukan', status:404}
GET {{baseUrl}}/rute-yang-tidak-ada
Accept: application/json

### E04 404 rute tidak ada (HTML) -> error.html.twig status 404
GET {{baseUrl}}/rute-yang-tidak-ada
Accept: text/html

### E05 405 method salah (JSON) -> {success:false, message:'Metode tidak diizinkan', status:405}
# /products/create hanya POST; coba GET
GET {{baseUrl}}/products/create
Accept: application/json

### E06 422 validasi create (JSON) -> {success:false, message:'Validasi gagal', errors, status:422}
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "price": -100,
  "stock": "abc"
}

### E07 422 validasi update body kosong (JSON) -> errors.general, bukan trace
PUT {{baseUrl}}/products/1
Content-Type: application/json
Accept: application/json

{}

### E08 404 delete tidak ada (JSON) -> {success:false, status:404}, bukan stack trace
DELETE {{baseUrl}}/products/9999
Accept: application/json

### E09 500 generik tanpa bocor (contoh: matikan DB lalu hit ini, harus tetap generik)
# Harap: {success:false, message:'Gagal mengakses database'|'Terjadi kesalahan pada server', status:500}
# Tidak boleh ada: SQL, DSN, path file, trace, token
GET {{baseUrl}}/products/show/1
Accept: application/json

############################################################
### M1 MCP JSON-RPC (POST /mcp -> McpController::handle)
############################################################

### M01 initialize -> 200 result.protocolVersion + serverInfo
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {}
}

### M02 tools/list -> 200 result.tools[0].name = get_products
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

### M03 tools/call get_products -> 200 result.content[0].text (dummy list)
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "get_products",
    "arguments": {}
  }
}

### M04 tools/call unknown tool -> 200 error.code -32602 Unknown tool
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "tool_tidak_ada",
    "arguments": {}
  }
}

### M05 method tidak dikenal -> 200 error.code -32601 Method not found
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json

{
  "jsonrpc": "2.0",
  "id": 5,
  "method": "method_tidak_ada",
  "params": {}
}

### M06 body bukan JSON -> 200 error.code -32700 Parse error
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json

bukan-json

############################################################
### L1 Logging (config/logging.php + src/Support/AppLogger.php
### + src/Middleware/RequestLoggingMiddleware.php)
### File: var/log/app-YYYY-MM-DD.log (gitignored, rotasi harian)
### Setiap request di bawah menulis 1 baris aktivitas (level otomatis:
### 2xx/3xx=INFO, 4xx=WARNING, 5xx=ERROR) + error menulis detail server-side.
### Cara cek: Get-Content var/log/app-$(Get-Date -Format yyyy-MM-dd).log -Tail 20
### Token/password di log selalu *** (lihat L04).
############################################################

### L01 aktivitas INFO (2xx) -> cek baris "GET / -> 200" di log
GET {{baseUrl}}/
Accept: */*

### L02 aktivitas WARNING (404) -> cek baris "GET /products/show/9999 -> 404" di log
GET {{baseUrl}}/products/show/9999
Accept: application/json

### L03 error + WARNING (422) -> cek baris validasi + context.errors di log
POST {{baseUrl}}/products/create
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "price": -100,
  "stock": "abc"
}

### L04 redaksi sensitif -> di log harus "token=***", BUKAN token asli
GET {{baseUrl}}/products?token=rahasia-jangan-bocor
Accept: application/json

### L05 aktivitas HTML page (200) -> cek baris "GET /products/page -> 200" di log
GET {{baseUrl}}/products/page
Accept: text/html
