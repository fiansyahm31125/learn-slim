<?php

declare(strict_types=1);

use Doctrine\DBAL\DriverManager;
use Doctrine\ORM\EntityManager;
use Doctrine\ORM\ORMSetup;
use Symfony\Component\Cache\Adapter\ArrayAdapter;
use Symfony\Component\Cache\Adapter\FilesystemAdapter;

function getEntityManager(bool $isDevMode = true): EntityManager
{
    // Folder berisi Entity (Attribute mapping)
    $paths = [__DIR__ . '/../src/Entity'];

    $cache = $isDevMode
        ? new ArrayAdapter()
        : new FilesystemAdapter(directory: __DIR__ . '/../var/cache/doctrine');

    $config = ORMSetup::createAttributeMetadataConfiguration($paths, $isDevMode, null, $cache);

    // SQLite file sederhana, cocok untuk contoh belajar.
    // File DB disimpan di var/database.sqlite (di-ignore git)
    $dbPath = __DIR__ . '/../var/database.sqlite';
    if (!is_dir(dirname($dbPath))) {
        mkdir(dirname($dbPath), 0777, true);
    }

    $connection = DriverManager::getConnection([
        'driver' => 'pdo_sqlite',
        'path' => $dbPath,
    ], $config);

    return new EntityManager($connection, $config);
}
