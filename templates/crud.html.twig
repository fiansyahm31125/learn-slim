<!DOCTYPE html>
<html>
<head>
    <title>Daftar Produk</title>
</head>
<body>
<h1>Daftar Produk ({{ products|length }})</h1>
<table border="1" cellpadding="8">
    <tr>
        <th>ID</th><th>Nama</th><th>Harga</th><th>Stok</th><th>Actions</th>
    </tr>
    {% for p in products %}
    <tr>
        <td>{{ p.id }}</td>
        <td>{{ p.name }}</td>
        <td>Rp {{ p.price|number_format(0, ',', '.') }}</td>
        <td>{{ p.stock }}</td>
        <td>
            <button
                type="button"
                onclick="deleteProduct({{ p.id }})">
                Delete
            </button>
        </td>
    </tr>
    {% else %}
    <tr><td colspan="4">Belum ada data. Jalankan: php scripts/create-schema.php && php scripts/seed.php</td></tr>
    {% endfor %}
</table>

<script>
function deleteProduct(id) {
    fetch('/products/' + id, {
        method: 'DELETE'
    })
    .then(response => {
        if (response.ok) {
            window.location.reload();
        }
    });
}
</script>
</body>
</html>
