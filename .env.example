# Salin file ini menjadi .env lalu isi dengan token rahasia
# Generate token baru: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
AUTH_TOKEN=isi-dengan-token-rahasia

# Kontrol error output. false = production (response generik, tanpa trace/SQL/path).
# true = development saja (boleh tampilkan pesan exception, tetap tanpa stack trace).
APP_DEBUG=false
APP_ENV=production

# Logging file harian (tanpa dependensi tambahan).
# LOG_DIR default: <project>/var/log. LOG_LEVEL: debug|info|warning|error.
# LOG_REQUESTS=false untuk mematikan log aktivitas per-request (error tetap dicatat).
LOG_DIR=var/log
LOG_LEVEL=info
LOG_REQUESTS=true

# CORS: akses API dari frontend/domain lain.
# Dev (longgar): CORS_ALLOWED_ORIGINS=*
# Production (ketat, contoh): CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Bila CORS_ALLOW_CREDENTIALS=true, "*" TIDAK berlaku — wajib allowlist eksplisit.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,X-Requested-With
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=86400
